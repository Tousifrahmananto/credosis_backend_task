# Generate a different random token for each bus; never commit the real .env.
# Empty or shorter-than-32-character tokens disable writes for that bus (503).
TRACKER_TOKEN_DEMO_BUS_01=
TRACKER_TOKEN_DEMO_BUS_02=
# Optional: defaults to data/bus-tracker.sqlite relative to the project directory.
DATABASE_PATH=data/bus-tracker.sqlite
# Local defaults; hosting/container must use HOST=0.0.0.0 and its assigned PORT.
HOST=127.0.0.1
PORT=3000
